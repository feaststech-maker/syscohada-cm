APP_NAME="SYSCOHADA CM"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://$DOMAIN
APP_KEY=$APP_KEY
APP_CIPHER=AES-256-GCM
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_MAINTENANCE_DRIVER=file
DB_CONNECTION=pgsql
DB_HOST=/var/run/postgresql
DB_PORT=$PG_PORT
DB_DATABASE=syscohada
DB_USERNAME=syscohada_migrate
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/syscohada/pg-ca.crt
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
MAIL_MAILER=log
