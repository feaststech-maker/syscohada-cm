[syscohada]
user = syscohada_web
group = syscohada_web
listen = /run/php/syscohada.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 4
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 2
pm.max_requests = 500
request_terminate_timeout = 90s
chdir = /opt/syscohada/current
clear_env = yes
env[TMPDIR] = /run/syscohada-php
env[PGSSLROOTCERT] = /etc/syscohada/pg-ca.crt
security.limit_extensions = .php
catch_workers_output = yes
php_admin_value[upload_tmp_dir] = /run/syscohada-php
php_admin_value[sys_temp_dir] = /run/syscohada-php
php_admin_value[memory_limit] = 256M
php_admin_value[upload_max_filesize] = 8M
php_admin_value[post_max_size] = 9M
php_admin_value[max_execution_time] = 75
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_flag[expose_php] = off
php_admin_value[session.save_path] = /run/syscohada-php
